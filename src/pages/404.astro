---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Btn from "../components/Btn.astro";
---
<Base title="Page not found | Anvi Panchal" noindex>
  <Topbar slot="header" />
  <section class="section section--pink lines lost">
    <h1>This page is not here.</h1>
    <p>The address may have changed. Everything is still on the home page.</p>
    <Btn href="/" variant="white">Go to the home page</Btn>
  </section>
</Base>
