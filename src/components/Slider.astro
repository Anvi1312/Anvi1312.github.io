---
// A horizontal slider. Cards scroll sideways, and the two round buttons move it.
// Without JavaScript it is still a normal scrollable row.
import Icon from "./Icon.astro";
interface Props { label: string; wide?: boolean; id?: string }
const { label, wide = false, id } = Astro.props;
---
<div class="slider" data-slider id={id}>
  <div class="slider__head">
    <slot name="head" />
    <div class="slider__nav">
      <button type="button" data-prev aria-label={`Previous, ${label}`}><Icon name="left" size={18} /></button>
      <button type="button" data-next aria-label={`Next, ${label}`}><Icon name="right" size={18} /></button>
    </div>
  </div>
  <div class={`slider__track${wide ? " slider__track--wide" : ""}`} role="region" aria-label={label} tabindex="0">
    <slot />
  </div>
</div>
